    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-dev-money-add",
    "allow-app-bootstrap-state",
    "allow-setup-create-workspace",
    "allow-auth-list-users",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-auth-change-pin",
    "allow-auth-request-approval",
    "allow-staff-list",
    "allow-staff-create",
    "allow-staff-update",
    "allow-staff-deactivate",
    "allow-staff-reset-pin",
    "allow-register-go-live",
    "allow-tax-list",
    "allow-product-list",
    "allow-product-get",
    "allow-product-create",
    "allow-product-update",
    "allow-product-archive",
    "allow-catalog-lookup-code",
    "allow-catalog-search",
    "allow-scan-submit",
    "allow-cart-current",
    "allow-cart-add-variant",
    "allow-cart-set-quantity",
    "allow-cart-remove-line",
    "allow-cart-set-line-discount",
    "allow-cart-set-order-discount",
    "allow-cart-override-price",
    "allow-cart-clear",

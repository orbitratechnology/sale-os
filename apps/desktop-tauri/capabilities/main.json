    "allow-return-find",
    "allow-return-preview",
    "allow-return-create",
    "allow-return-receipt-get",
    "allow-return-receipt-print",
    "allow-sales-list",
    "allow-sales-get",
    "allow-inventory-post-document",
    "allow-stock-verify",
    "allow-stock-rebuild",
    "allow-reports-sales-summary",
    "allow-reports-tender-mix",
    "allow-reports-top-products",
    "allow-reports-stock",
    "allow-export-csv",
    "allow-cash-session-current",
    "allow-cash-session-open",
    "allow-cash-session-close",
    "allow-cash-session-z-get",
    "allow-cash-session-z-print"

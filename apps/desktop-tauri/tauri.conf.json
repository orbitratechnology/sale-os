{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sale OS",
  "version": "0.1.0",
  "identifier": "dev.saleos.pos",
  "build": {
    "frontendDist": "../desktop-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @sale-os/desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter @sale-os/desktop-ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sale OS",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}

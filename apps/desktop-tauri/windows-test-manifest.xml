<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded into integration-test executables on Windows (see build.rs). Test binaries that
  link Tauri need Common Controls v6, like the app binary, or Windows refuses to start
  them with STATUS_ENTRYPOINT_NOT_FOUND (0xc0000139). The app binary's own manifest is
  embedded by tauri-build.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>

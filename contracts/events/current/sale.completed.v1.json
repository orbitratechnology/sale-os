{
  "$defs": {
    "Confirmation": {
      "description": "`\"operator\"` (recorded by the cashier, PAY-003) or `{\"provider\": {...}}`.",
      "oneOf": [
        {
          "enum": [
            "operator"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "$ref": "#/$defs/ProviderApprovalV1"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        }
      ]
    },
    "Currency": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "exponent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "code",
        "exponent"
      ],
      "type": "object"
    },
    "DiscountV1": {
      "additionalProperties": false,
      "properties": {
        "authorized_by": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "$ref": "#/$defs/DiscountValue"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "DiscountValue": {
      "description": "Externally tagged: `{\"Percent\": ppm}` or `{\"Fixed\": minor}`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Percent": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "Percent"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Fixed": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "Fixed"
          ],
          "type": "object"
        }
      ]
    },
    "MovementSource": {
      "description": "What caused a movement (field names are snake_case on the wire).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "line_id": {
              "format": "uuid",
              "type": "string"
            },
            "sale_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "sale",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sale_id",
            "line_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "line_id": {
              "format": "uuid",
              "type": "string"
            },
            "return_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "return",
              "type": "string"
            }
          },
          "required": [
            "type",
            "return_id",
            "line_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "document_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "inventory_document",
              "type": "string"
            }
          },
          "required": [
            "type",
            "document_id"
          ],
          "type": "object"
        }
      ]
    },
    "MovementType": {
      "enum": [
        "opening",
        "receipt",
        "sale",
        "return_restock",
        "return_damaged",
        "damage",
        "loss",
        "adjustment",
        "write_off",
        "correction"
      ],
      "type": "string"
    },
    "ProductType": {
      "enum": [
        "stock",
        "non_stock",
        "service"
      ],
      "type": "string"
    },
    "ProviderApprovalV1": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "reference"
      ],
      "type": "object"
    },
    "SaleLineV1": {
      "additionalProperties": false,
      "properties": {
        "discount": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscountV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "gross": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "lineDiscount": {
          "format": "int64",
          "type": "integer"
        },
        "lineNo": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "orderDiscountAlloc": {
          "format": "int64",
          "type": "integer"
        },
        "priceOverridden": {
          "type": "boolean"
        },
        "productId": {
          "format": "uuid",
          "type": "string"
        },
        "productType": {
          "$ref": "#/$defs/ProductType"
        },
        "quantity": {
          "format": "int64",
          "type": "integer"
        },
        "sku": {
          "type": [
            "string",
            "null"
          ]
        },
        "tax": {
          "format": "int64",
          "type": "integer"
        },
        "taxLines": {
          "items": {
            "$ref": "#/$defs/TaxLineV1"
          },
          "type": "array"
        },
        "total": {
          "format": "int64",
          "type": "integer"
        },
        "trackStock": {
          "type": "boolean"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "unitCost": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "unitPrice": {
          "format": "int64",
          "type": "integer"
        },
        "variantId": {
          "format": "uuid",
          "type": "string"
        },
        "variantLabel": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "lineNo",
        "productId",
        "variantId",
        "name",
        "variantLabel",
        "productType",
        "unit",
        "trackStock",
        "quantity",
        "unitPrice",
        "priceOverridden",
        "gross",
        "lineDiscount",
        "orderDiscountAlloc",
        "tax",
        "taxLines",
        "total"
      ],
      "type": "object"
    },
    "SaleMode": {
      "enum": [
        "sandbox",
        "live"
      ],
      "type": "string"
    },
    "StockBucket": {
      "enum": [
        "sellable",
        "damaged"
      ],
      "type": "string"
    },
    "StockMovementV1": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "format": "uuid",
          "type": "string"
        },
        "bucket": {
          "$ref": "#/$defs/StockBucket"
        },
        "businessDate": {
          "type": "string"
        },
        "delta": {
          "description": "Signed milli-units.",
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "locationId": {
          "format": "uuid",
          "type": "string"
        },
        "movementType": {
          "$ref": "#/$defs/MovementType"
        },
        "occurredAt": {
          "format": "int64",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/MovementSource"
        },
        "unitCost": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "variantId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "variantId",
        "locationId",
        "bucket",
        "movementType",
        "delta",
        "source",
        "actor",
        "occurredAt",
        "businessDate"
      ],
      "type": "object"
    },
    "TaxLineV1": {
      "additionalProperties": false,
      "description": "Field names are snake_case on the wire.",
      "properties": {
        "name": {
          "type": "string"
        },
        "rate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "tax": {
          "format": "int64",
          "type": "integer"
        },
        "tax_rate_id": {
          "format": "uuid",
          "type": "string"
        },
        "taxable": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "tax_rate_id",
        "name",
        "rate",
        "taxable",
        "tax"
      ],
      "type": "object"
    },
    "TenderKind": {
      "enum": [
        "cash",
        "card_external",
        "bank_transfer_external",
        "qr_external",
        "other_external"
      ],
      "type": "string"
    },
    "TenderStatus": {
      "enum": [
        "pending",
        "confirmed",
        "declined",
        "reversed",
        "refunded",
        "reconciliation_required"
      ],
      "type": "string"
    },
    "TenderV1": {
      "additionalProperties": false,
      "description": "A sale tender or a return refund. Field names are snake_case on the wire.",
      "properties": {
        "amount": {
          "description": "Applied to the sale (cash: handed over less change).",
          "format": "int64",
          "type": "integer"
        },
        "change": {
          "format": "int64",
          "type": "integer"
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "external_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TenderKind"
        },
        "received": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "seq": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/TenderStatus"
        }
      },
      "required": [
        "id",
        "seq",
        "kind",
        "amount",
        "change",
        "status",
        "confirmation"
      ],
      "type": "object"
    },
    "Unit": {
      "enum": [
        "ea",
        "kg",
        "g",
        "l",
        "ml",
        "m",
        "cm",
        "box",
        "pack"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The whole sale, self-contained: the server never looks up current prices (PRD §8.3).",
  "properties": {
    "approver": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "businessDate": {
      "type": "string"
    },
    "cartId": {
      "format": "uuid",
      "type": "string"
    },
    "cashier": {
      "format": "uuid",
      "type": "string"
    },
    "change": {
      "format": "int64",
      "type": "integer"
    },
    "currency": {
      "$ref": "#/$defs/Currency"
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "lineDiscountTotal": {
      "format": "int64",
      "type": "integer"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/SaleLineV1"
      },
      "type": "array"
    },
    "locationId": {
      "format": "uuid",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/SaleMode"
    },
    "occurredAt": {
      "format": "int64",
      "type": "integer"
    },
    "orderDiscount": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscountV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "orderDiscountTotal": {
      "format": "int64",
      "type": "integer"
    },
    "pricesIncludeTax": {
      "type": "boolean"
    },
    "receiptNumber": {
      "type": "string"
    },
    "receiptSeq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "registerId": {
      "format": "uuid",
      "type": "string"
    },
    "rounding": {
      "format": "int64",
      "type": "integer"
    },
    "stockMovements": {
      "items": {
        "$ref": "#/$defs/StockMovementV1"
      },
      "type": "array"
    },
    "subtotal": {
      "format": "int64",
      "type": "integer"
    },
    "taxBreakdown": {
      "items": {
        "$ref": "#/$defs/TaxLineV1"
      },
      "type": "array"
    },
    "taxTotal": {
      "format": "int64",
      "type": "integer"
    },
    "tenderedTotal": {
      "format": "int64",
      "type": "integer"
    },
    "tenders": {
      "items": {
        "$ref": "#/$defs/TenderV1"
      },
      "type": "array"
    },
    "timezone": {
      "type": "string"
    },
    "total": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "cartId",
    "registerId",
    "locationId",
    "cashier",
    "mode",
    "receiptSeq",
    "receiptNumber",
    "occurredAt",
    "businessDate",
    "timezone",
    "currency",
    "pricesIncludeTax",
    "lines",
    "subtotal",
    "lineDiscountTotal",
    "orderDiscountTotal",
    "taxTotal",
    "taxBreakdown",
    "rounding",
    "total",
    "tenderedTotal",
    "change",
    "tenders",
    "stockMovements"
  ],
  "title": "sale.completed v1",
  "type": "object",
  "x-schema-version": 1
}

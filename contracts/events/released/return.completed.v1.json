{
  "$defs": {
    "Confirmation": {
      "description": "`\"operator\"` (recorded by the cashier, PAY-003) or `{\"provider\": {...}}`.",
      "oneOf": [
        {
          "enum": [
            "operator"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "$ref": "#/$defs/ProviderApprovalV1"
            }
          },
          "required": [
            "provider"
          ],
          "type": "object"
        }
      ]
    },
    "Currency": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "exponent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "code",
        "exponent"
      ],
      "type": "object"
    },
    "Disposition": {
      "enum": [
        "restock",
        "damaged",
        "no_stock_change"
      ],
      "type": "string"
    },
    "MovementSource": {
      "description": "What caused a movement (field names are snake_case on the wire).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "line_id": {
              "format": "uuid",
              "type": "string"
            },
            "sale_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "sale",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sale_id",
            "line_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "line_id": {
              "format": "uuid",
              "type": "string"
            },
            "return_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "return",
              "type": "string"
            }
          },
          "required": [
            "type",
            "return_id",
            "line_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "document_id": {
              "format": "uuid",
              "type": "string"
            },
            "type": {
              "const": "inventory_document",
              "type": "string"
            }
          },
          "required": [
            "type",
            "document_id"
          ],
          "type": "object"
        }
      ]
    },
    "MovementType": {
      "enum": [
        "opening",
        "receipt",
        "sale",
        "return_restock",
        "return_damaged",
        "damage",
        "loss",
        "adjustment",
        "write_off",
        "correction"
      ],
      "type": "string"
    },
    "ProviderApprovalV1": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "reference"
      ],
      "type": "object"
    },
    "ReturnLineV1": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "productId": {
          "format": "uuid",
          "type": "string"
        },
        "quantity": {
          "format": "int64",
          "type": "integer"
        },
        "refund": {
          "format": "int64",
          "type": "integer"
        },
        "saleLineId": {
          "format": "uuid",
          "type": "string"
        },
        "tax": {
          "format": "int64",
          "type": "integer"
        },
        "trackStock": {
          "type": "boolean"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "unitCost": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "variantId": {
          "format": "uuid",
          "type": "string"
        },
        "variantLabel": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "saleLineId",
        "productId",
        "variantId",
        "name",
        "variantLabel",
        "unit",
        "trackStock",
        "quantity",
        "disposition",
        "refund",
        "tax"
      ],
      "type": "object"
    },
    "ReturnReason": {
      "enum": [
        "changed_mind",
        "defective",
        "wrong_item",
        "damaged_in_transit",
        "other"
      ],
      "type": "string"
    },
    "StockBucket": {
      "enum": [
        "sellable",
        "damaged"
      ],
      "type": "string"
    },
    "StockMovementV1": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "format": "uuid",
          "type": "string"
        },
        "bucket": {
          "$ref": "#/$defs/StockBucket"
        },
        "businessDate": {
          "type": "string"
        },
        "delta": {
          "description": "Signed milli-units.",
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "locationId": {
          "format": "uuid",
          "type": "string"
        },
        "movementType": {
          "$ref": "#/$defs/MovementType"
        },
        "occurredAt": {
          "format": "int64",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/MovementSource"
        },
        "unitCost": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "variantId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "variantId",
        "locationId",
        "bucket",
        "movementType",
        "delta",
        "source",
        "actor",
        "occurredAt",
        "businessDate"
      ],
      "type": "object"
    },
    "TenderKind": {
      "enum": [
        "cash",
        "card_external",
        "bank_transfer_external",
        "qr_external",
        "other_external"
      ],
      "type": "string"
    },
    "TenderStatus": {
      "enum": [
        "pending",
        "confirmed",
        "declined",
        "reversed",
        "refunded",
        "reconciliation_required"
      ],
      "type": "string"
    },
    "TenderV1": {
      "additionalProperties": false,
      "description": "A sale tender or a return refund. Field names are snake_case on the wire.",
      "properties": {
        "amount": {
          "description": "Applied to the sale (cash: handed over less change).",
          "format": "int64",
          "type": "integer"
        },
        "change": {
          "format": "int64",
          "type": "integer"
        },
        "confirmation": {
          "$ref": "#/$defs/Confirmation"
        },
        "external_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TenderKind"
        },
        "received": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "seq": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/TenderStatus"
        }
      },
      "required": [
        "id",
        "seq",
        "kind",
        "amount",
        "change",
        "status",
        "confirmation"
      ],
      "type": "object"
    },
    "Unit": {
      "enum": [
        "ea",
        "kg",
        "g",
        "l",
        "ml",
        "m",
        "cm",
        "box",
        "pack"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "format": "uuid",
      "type": "string"
    },
    "approver": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "businessDate": {
      "type": "string"
    },
    "currency": {
      "$ref": "#/$defs/Currency"
    },
    "id": {
      "format": "uuid",
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/ReturnLineV1"
      },
      "type": "array"
    },
    "locationId": {
      "format": "uuid",
      "type": "string"
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAt": {
      "format": "int64",
      "type": "integer"
    },
    "originalReceiptNumber": {
      "type": "string"
    },
    "originalSale": {
      "format": "uuid",
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/ReturnReason"
    },
    "receiptNumber": {
      "type": "string"
    },
    "receiptSeq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "refunds": {
      "items": {
        "$ref": "#/$defs/TenderV1"
      },
      "type": "array"
    },
    "registerId": {
      "format": "uuid",
      "type": "string"
    },
    "stockMovements": {
      "items": {
        "$ref": "#/$defs/StockMovementV1"
      },
      "type": "array"
    },
    "subtotal": {
      "format": "int64",
      "type": "integer"
    },
    "tax": {
      "format": "int64",
      "type": "integer"
    },
    "timezone": {
      "type": "string"
    },
    "total": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "originalSale",
    "originalReceiptNumber",
    "registerId",
    "locationId",
    "actor",
    "receiptSeq",
    "receiptNumber",
    "reason",
    "occurredAt",
    "businessDate",
    "timezone",
    "currency",
    "lines",
    "subtotal",
    "tax",
    "total",
    "refunds",
    "stockMovements"
  ],
  "title": "return.completed v1",
  "type": "object",
  "x-schema-version": 1
}
